# Copy to .env.ads (gitignored). Read by scripts/ads-publish.mjs and by each project's
# publish script. Nothing here is needed on Render: the site reads the bucket directly.

# Cloudflare account id (R2 > Overview, right-hand column) and an R2 API token with
# Object Read & Write on the bucket (R2 > Manage R2 API Tokens).
ADS_R2_ACCOUNT_ID=
ADS_R2_ACCESS_KEY_ID=
ADS_R2_SECRET_ACCESS_KEY=
ADS_R2_BUCKET=ads

# The public r2.dev URL of the bucket (Settings > Public access), without a trailing slash.
ADS_PUBLIC_BASE=

# The prefix every object sits under. Anyone with it can read the studios, so make it long
# and random (for example `openssl rand -base64 24 | tr -d '/+='`) and keep it out of git.
ADS_KEY=

# Optional: write to a local folder instead of the bucket, for checking a layout without
# uploading. `node scripts/ads-publish.mjs serve` then serves it on 8200.
# ADS_LOCAL_DIR=.scratchpad/ads-local

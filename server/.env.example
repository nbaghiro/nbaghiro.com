NODE_ENV=development
PORT=3100
CLIENT_URL=http://localhost:5283

# Claude API key for the project chat ("Ask the code")
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional overrides
# CHAT_MODEL=claude-opus-5
# CHAT_DAILY_CAP_USD=5
# CHAT_QUESTIONS_PER_VISITOR=10

# Render Key Value connection string. Without it, the chat's spend and
# per-visitor counters are kept in memory (fine for local development).
# REDIS_URL=redis://localhost:6379
